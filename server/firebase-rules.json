{
  "rules": {
    "raids": {
      "$room": {
        ".read": "$room.matches(/^[0-9]{4}$/)",
        ".write": "$room.matches(/^[0-9]{4}$/)",
        "p": {
          "$pid": {
            ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10"
          }
        },
        "ev": {
          "$e": {
            ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 40"
          }
        },
        "$other": {
          ".validate": "$other.matches(/^(cfg|st|sh)$/)"
        }
      }
    },
    "battle": {
      "$room": {
        ".read": "$room.matches(/^[0-9]{4}$/)",
        ".write": "$room.matches(/^[0-9]{4}$/)",
        "p": {
          "$pid": {
            ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10"
          }
        },
        "$other": {
          ".validate": "$other.matches(/^(cfg|st|fx)$/)"
        }
      }
    },
    "hy": {
      ".read": true,
      "roster": {
        ".write": true
      },
      "boss": {
        ".write": true
      },
      "dmg": {
        "$b": {
          "$k": {
            ".write": true,
            ".validate": "!newData.child('d').exists() || (newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 1000000)"
          }
        }
      },
      "exam": {
        "open": {
          "$id": {
            ".write": true
          }
        },
        "hist": {
          "$id": {
            ".write": true
          }
        },
        "res": {
          "$id": {
            "$k": {
              ".write": "!data.child('sc').exists() || !newData.exists()",
              ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10 && (!newData.child('sc').exists() || (newData.child('sc').isNumber() && newData.child('sc').val() >= 0 && newData.child('sc').val() <= 100))"
            }
          }
        }
      },
      "hw": {
        "cur": {
          ".write": true
        },
        "res": {
          "$id": {
            "$k": {
              ".write": true,
              ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10"
            }
          }
        }
      },
      "day": {
        "$d": {
          "$k": {
            ".write": true
          }
        }
      },
      "cheer": {
        "$to": {
          "$d": {
            "$id": {
              ".write": "!data.exists()",
              ".validate": "newData.child('e').isString() && newData.child('e').val().length <= 4 && newData.child('f').isString() && newData.child('f').val().length <= 10 && newData.child('at').isNumber()"
            }
          }
        }
      },
      "life": {
        "h": {
          ".indexOn": [
            "t",
            "at"
          ],
          "$c": {
            ".write": true,
            ".validate": "$c.matches(/^[A-Z2-9]{5}$/) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').isString() && newData.child('t').val().length <= 20 && newData.child('at').isNumber() && (!newData.child('p').exists() || newData.child('p').hasChildren()) && (!newData.child('g').exists() || (newData.child('g').isString() && newData.child('g').val().matches(/^[0-9]{4}$/)))"
          }
        },
        "req": {
          "$to": {
            "$f": {
              ".write": true,
              ".validate": "$f.matches(/^[A-Z2-9]{5}$/) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('at').isNumber()"
            }
          }
        },
        "fr": {
          "$c": {
            "$f": {
              ".write": true,
              ".validate": "$f.matches(/^[A-Z2-9]{5}$/) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('at').isNumber()"
            }
          }
        },
        "lk": {
          "$c": {
            "$f": {
              ".write": true,
              ".validate": "$f.matches(/^[A-Z2-9]{5}$/) && newData.isString() && newData.val().length == 10"
            }
          }
        },
        "gb": {
          "$c": {
            "$id": {
              ".write": "!data.exists()",
              ".validate": "newData.child('e').isString() && newData.child('e').val().length <= 4 && newData.child('f').isString() && newData.child('f').val().length == 5 && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('at').isNumber()"
            }
          }
        },
        "tag": {
          "$n": {
            ".write": "!data.exists()",
            ".validate": "$n.matches(/^[0-9]{4}$/) && newData.isString() && newData.val().matches(/^[A-Z2-9]{5}$/)"
          }
        },
        "kid": {
          "$rid": {
            ".write": "!data.exists()",
            ".validate": "$rid.length <= 60 && newData.child('c').isString() && newData.child('c').val().matches(/^[A-Z2-9]{5}$/) && newData.child('g').isString() && newData.child('g').val().matches(/^[0-9]{4}$/)"
          }
        },
        "sv": {
          "$rid": {
            ".write": true,
            ".validate": "$rid.length <= 60 && newData.child('at').isNumber() && newData.child('d').isString() && newData.child('d').val().length < 300000 && newData.child('n').isString() && newData.child('n').val().length <= 12"
          }
        }
      },
      "pads": {
        "$dev": {
          ".write": true,
          ".validate": "$dev.matches(/^[a-z0-9]{6,40}$/) && (!newData.exists() || (newData.child('k').isString() && newData.child('k').val().length <= 40 && newData.child('n').isString() && newData.child('n').val().length <= 12))"
        }
      },
      "gift": {
        "$kid": {
          "$id": {
            ".write": true,
            ".validate": "!newData.exists() || (newData.child('at').isNumber() && (!newData.child('g').exists() || (newData.child('g').isNumber() && newData.child('g').val() >= 0 && newData.child('g').val() <= 500)) && (!newData.child('from').exists() || newData.child('from').val().length <= 20))"
          }
        }
      },
      "move": {
        "$kid": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.child('at').isNumber() && newData.child('d').isString() && newData.child('d').val().length < 4000000)"
        }
      },
      "acct": {
        "$kid": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.child('at').isNumber() && newData.child('d').isString() && newData.child('d').val().length < 4000000 && newData.child('n').isString() && newData.child('n').val().length <= 12)"
        }
      },
      "isle": {
        "lot2": {
          "$id": {
            ".write": true,
            ".validate": "$id.matches(/^[1-6]-[0-9]{1,2}$/) && newData.child('k').isString() && newData.child('k').val().length <= 48 && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('at').isNumber()"
          }
        },
        "ft": {
          "$s": {
            "$k": {
              ".write": true,
              ".validate": "newData.child('s').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 12"
            }
          }
        },
        "ox": {
          "$d": {
            "$k": {
              ".write": true,
              ".validate": "newData.child('s').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 12"
            }
          }
        },
        "tr": {
          "$d": {
            "$k": {
              ".write": true,
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            }
          }
        },
        "goal": {
          "$w": {
            "by": {
              "$c": {
                ".write": true,
                ".validate": "$c.matches(/^[A-Z2-9]{5}$/) && newData.child('v').isNumber() && newData.child('v').val() >= 0 && newData.child('v').val() <= 5000 && newData.child('n').isString() && newData.child('n').val().length <= 12"
              }
            }
          }
        },
        "mail": {
          "$to": {
            "$id": {
              ".write": true,
              ".validate": "$to.matches(/^[A-Z2-9]{5}$/) && newData.child('f').isString() && newData.child('f').val().matches(/^[A-Z2-9]{5}$/) && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 11 && newData.child('st').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').isNumber() && (!newData.child('g').exists() || (newData.child('g').isString() && newData.child('g').val().length <= 12))"
            }
          }
        },
        "museum": {
          "$k": {
            ".write": "!data.exists()",
            ".validate": "$k.matches(/^[a-z_]{2,20}$/) && newData.child('c').isString() && newData.child('c').val().matches(/^[A-Z2-9]{5}$/) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').isNumber()"
          }
        }
      }
    }
  }
}
