{
  "rules": {
    "raids": {
      "$room": {
        ".read": "$room.matches(/^[0-9]{4}$/)",
        ".write": "$room.matches(/^[0-9]{4}$/)",
        "p": { "$pid": { ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10" } },
        "ev": { "$e": { ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 12" } },
        "$other": { ".validate": "$other.matches(/^(cfg|st|sh)$/)" }
      }
    },
    "battle": {
      "$room": {
        ".read": "$room.matches(/^[0-9]{4}$/)",
        ".write": "$room.matches(/^[0-9]{4}$/)",
        "p": { "$pid": { ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10" } },
        "$other": { ".validate": "$other.matches(/^(cfg|st)$/)" }
      }
    },
    "hy": {
      ".read": true,
      "roster": { ".write": true },
      "boss": { ".write": true },
      "dmg": {
        "$b": {
          "$k": {
            ".write": true,
            ".validate": "!newData.child('d').exists() || (newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 1000000)"
          }
        }
      },
      "exam": {
        "open": { "$id": { ".write": true } },
        "hist": { "$id": { ".write": true } },
        "res": {
          "$id": {
            "$k": {
              ".write": "!data.child('sc').exists() || !newData.exists()",
              ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10 && (!newData.child('sc').exists() || (newData.child('sc').isNumber() && newData.child('sc').val() >= 0 && newData.child('sc').val() <= 100))"
            }
          }
        }
      },
      "hw": {
        "cur": { ".write": true },
        "res": { "$id": { "$k": { ".write": true, ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 10" } } }
      },
      "day": { "$d": { "$k": { ".write": true } } }
    }
  }
}
